{
  "@context": "https://schema.org",
  "@type": "Dataset",
  "name": "Misata Almanac",
  "description": "An open, proof-backed knowledge base of real-world data rules and patterns for synthetic data generation: check-digit algorithms, identifier formats, tax rates, calendars, code lists, and distributions from official statistics, each cited to a primary source with a content hash and executable tests.",
  "url": "https://github.com/Misata-labs/almanac",
  "sameAs": "https://github.com/Misata-labs/almanac",
  "license": "https://opendatacommons.org/licenses/odbl/1-0/",
  "isAccessibleForFree": true,
  "creator": {
    "@type": "Person",
    "name": "Muhammed Rasin"
  },
  "publisher": {
    "@type": "Organization",
    "name": "Misata Labs",
    "url": "https://github.com/Misata-labs/almanac"
  },
  "keywords": [
    "BR data rules",
    "GB data rules",
    "IN data rules",
    "calendar",
    "check digit",
    "company",
    "contact",
    "currency",
    "data quality",
    "data validation",
    "demographics",
    "identifiers",
    "official statistics",
    "payments",
    "rates",
    "reference data",
    "synthetic data",
    "tax",
    "test data"
  ],
  "spatialCoverage": [
    "BR",
    "GB",
    "IN",
    "global"
  ],
  "distribution": [
    {
      "@type": "DataDownload",
      "encodingFormat": "application/json",
      "contentUrl": "https://raw.githubusercontent.com/Misata-labs/almanac/main/manifest.json"
    },
    {
      "@type": "DataDownload",
      "encodingFormat": "application/x-yaml",
      "contentUrl": "https://raw.githubusercontent.com/Misata-labs/almanac/main/entries/"
    }
  ],
